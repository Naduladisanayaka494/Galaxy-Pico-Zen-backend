# Copy to .env and fill in. Spring Boot does not read .env files on its own —
# they only take effect via a launcher that loads them (e.g. `env $(cat .env)`,
# an IDE run config, or a shell that exports them) before `mvnw spring-boot:run`.
# Every value falls back to the default in application.properties when unset.

AWS_REGION=eu-north-1

DB_URL=jdbc:postgresql://<host>:5432/postgres?currentSchema=galaxy,public
DB_USERNAME=postgres
DB_PASSWORD=change-me

# validate | update | none — use validate once the schema is provisioned;
# Hibernate checks every entity against the `galaxy` schema at boot.
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=true

# HS256 signing key, 32+ chars. This is the entire trust boundary between
# tenants and between tenant/platform tokens — do not ship the checked-in
# default anywhere real.
JWT_SECRET=change-me-to-a-random-32-plus-character-string
# Platform (KNOX staff) tokens only — no refresh mechanism exists for
# platform auth, so this stays a full session length.
JWT_EXPIRATION=86400000
# Tenant access tokens only — short-lived, renewed via POST /api/auth/refresh.
JWT_ACCESS_TOKEN_EXPIRATION=900000
# How long a refresh token (knox.refresh_tokens row + httpOnly cookie) stays
# valid before the user must fully log in again.
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Comma-separated explicit origin allow-list for CORS (never "*" — combined
# with credentialed cookies, wildcard would let any site ride on them).
CORS_ALLOWED_ORIGINS=http://localhost:5173

SERVER_PORT=8080

# --- Multi-tenancy ---
# Schema Hibernate's ddl-auto=validate checks at startup, before any tenant is
# bound. Must stay structurally identical to every tenant_<slug> schema.
TENANCY_TEMPLATE_SCHEMA=galaxy

# --- First KNOX staff account ---
# Applied once, only when knox.platform_users is empty — a redeploy never
# resets an existing admin's password. Leave both unset after the first boot.
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=
PLATFORM_BOOTSTRAP_NAME=KNOX Admin

# --- Outbound email (new tenant welcome messages) ---
# Gmail SMTP: MAIL_USERNAME is the sending Gmail address, MAIL_PASSWORD is a
# 16-char Google App Password (needs 2-Step Verification enabled on the
# account) — https://myaccount.google.com/apppasswords. NOT the account login
# password; Gmail rejects that over SMTP.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Where a new tenant owner's welcome email sends them to log in.
GALAXY_FRONTEND_URL=http://localhost:5173
