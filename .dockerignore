# Keep the build context small and, more importantly, keep secrets out of it —
# .env holds live DB and SMTP credentials and must never reach an image layer.
# The container gets its config from docker-compose's environment instead.
.env
.env.*
!.env.example

target/
.git/
.gitignore
.gitattributes
.mvn/
mvnw
mvnw.cmd

docs/
*.md
*.pdf
*.txt
